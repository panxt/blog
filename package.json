{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "powershell -ExecutionPolicy Bypass -File tools/hexo-node16.ps1 generate",
    "clean": "powershell -ExecutionPolicy Bypass -File tools/hexo-node16.ps1 clean",
    "deploy": "powershell -ExecutionPolicy Bypass -File tools/publish.ps1",
    "server": "powershell -ExecutionPolicy Bypass -File tools/hexo-node16.ps1 server",
    "preview": "powershell -ExecutionPolicy Bypass -File tools/hexo-node16.ps1 server --port 4000 --host 127.0.0.1"
  },
  "hexo": {
    "version": "4.2.1"
  },
  "dependencies": {
    "hexo": "^4.2.1",
    "hexo-deployer-git": "^2.1.0",
    "hexo-generator-archive": "^1.0.0",
    "hexo-generator-category": "^1.0.0",
    "hexo-generator-index": "^1.0.0",
    "hexo-generator-search": "^2.4.0",
    "hexo-generator-tag": "^1.0.0",
    "hexo-renderer-ejs": "^1.0.0",
    "hexo-renderer-marked": "^2.0.0",
    "hexo-renderer-stylus": "^1.1.0",
    "hexo-server": "^1.0.0"
  }
}
